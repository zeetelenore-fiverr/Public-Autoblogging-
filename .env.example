# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the Settings menu in the AI Studio UI.
GEMINI_API_KEY=

# OPTIONAL AI PROVIDER KEYS:
# Users can also input these directly into the in-app AI Keys panel
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
XAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

